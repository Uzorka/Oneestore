# ONEESTORE
#
# Copy to `.env.local` and fill in. With these unset the app runs entirely on
# seed data and browser storage — everything works, but nothing is shared
# between devices and the shop cannot see a customer's order.

# Supabase — Project Settings -> API.
# The anon key is public: it ships in the browser bundle and is meant to.
# Row-level security is what protects the data, which is why the migration
# leaves no table in `public` without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security entirely — never prefix this with
# NEXT_PUBLIC_, and never read it from a component that runs in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Termii, for the verification codes that are currently shown on screen.
# `SmsSender` in src/lib/otp.ts is the one object to replace.
TERMII_API_KEY=
TERMII_SENDER_ID=

# Paystack, for when payment is connected. The order machine already has
# `pending_payment -> paid` as a legal move.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
