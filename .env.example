# Supabase — the storefront reads the catalog with the anon key; server-only
# work (order writes, packed-weight capture) uses the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack. The public key initialises checkout in the browser; the secret key
# and webhook secret are server-only and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Termii for phone OTP (better Nigerian SMS deliverability than generic providers)
TERMII_API_KEY=
TERMII_SENDER_ID=

# WhatsApp Cloud API for order-status messages
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
